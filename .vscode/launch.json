{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/electron-vite",
      "windows": {
        "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/electron-vite.cmd"
      },
      "runtimeArgs": ["dev", "--watch", "--sourcemap", "--inspect=5858", "--remoteDebuggingPort=9222"]
    },
    {
      "name": "Debug Main Attach",
      "port": 5858,
      "request": "attach",
      "type": "node",
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Debug Renderer Process",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Debug Main Process", "Debug Main Attach", "Debug Renderer Process"],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}
